# ============================================
# CONFIGURACIÓN DE BASE DE DATOS
# ============================================
POSTGRES_PASSWORD=postgres
POSTGRES_USER=postgres
POSTGRES_DB=vetclinic_db

# Para producción (cuando uses RDS en AWS)
DATABASE_URL=jdbc:postgresql://your-rds-endpoint:5432/vetclinic_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your-secure-password

# ============================================
# CONFIGURACIÓN DE JWT
# ============================================
# ⚠️ IMPORTANTE: Genera una clave secreta segura para producción
# Puedes generar una con: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ============================================
# CONFIGURACIÓN DE EMAIL (Gmail)
# ============================================
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# ============================================
# CONFIGURACIÓN DE TWILIO (SMS)
# ============================================
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ============================================
# CONFIGURACIÓN DE LA APLICACIÓN
# ============================================
CLINIC_NAME=VetClinic Pro

# URLs de desarrollo
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8081

# URLs de producción (configurar según tu dominio)
# FRONTEND_URL=https://tu-dominio.com
# BACKEND_URL=https://api.tu-dominio.com

# CORS Origins (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Para producción:
# CORS_ORIGINS=https://tu-dominio.com,https://www.tu-dominio.com

# ============================================
# CONFIGURACIÓN DEL FRONTEND
# ============================================
VITE_API_BASE_URL=http://localhost:8081/api
# Para producción:
# VITE_API_BASE_URL=https://api.tu-dominio.com/api

