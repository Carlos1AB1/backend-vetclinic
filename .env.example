# VetClinic Backend - Variables de Entorno (EJEMPLO)
# Copia este archivo a .env y configura tus valores

# Configuración de correo (Gmail)
MAIL_USERNAME=tu-email@gmail.com
MAIL_PASSWORD=tu-app-password-de-gmail

# Base de datos (PostgreSQL)
DATABASE_URL=jdbc:postgresql://localhost:5432/vetclinic_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=tu-password

# JWT Secret (genera uno seguro en producción)
JWT_SECRET=tu-secret-key-segura

# URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8081

# CORS Origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080
