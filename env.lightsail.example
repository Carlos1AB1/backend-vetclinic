# ============================================
# CONFIGURACIÓN DE BASE DE DATOS
# ============================================
POSTGRES_PASSWORD=tu-password-segura-aqui
POSTGRES_USER=postgres
POSTGRES_DB=vetclinic_db

# Database para Docker Compose (usar postgres como hostname)
DATABASE_URL=jdbc:postgresql://postgres:5432/vetclinic_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=tu-password-segura-aqui

# ============================================
# CONFIGURACIÓN DE JWT
# ============================================
# ⚠️ IMPORTANTE: Genera una clave secreta segura para producción
# Puedes generar una en el servidor con: openssl rand -base64 32
JWT_SECRET=tu-super-secret-jwt-key-minimo-64-caracteres-cambiar-en-produccion

# ============================================
# CONFIGURACIÓN DE EMAIL (Gmail)
# ============================================
MAIL_USERNAME=tu-email@gmail.com
MAIL_PASSWORD=tu-gmail-app-password

# ============================================
# CONFIGURACIÓN DE TWILIO (SMS) - Opcional
# ============================================
TWILIO_ACCOUNT_SID=tu-twilio-account-sid
TWILIO_AUTH_TOKEN=tu-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ============================================
# CONFIGURACIÓN DE LA APLICACIÓN
# ============================================
CLINIC_NAME=VetClinic Pro

# URLs para Lightsail (IP pública: 3.232.108.231)
FRONTEND_URL=http://3.232.108.231
BACKEND_URL=http://3.232.108.231:8081

# CORS Origins (IP pública de Lightsail)
CORS_ORIGINS=http://3.232.108.231

# ============================================
# CONFIGURACIÓN DEL FRONTEND
# ============================================
# ⚠️ IMPORTANTE: Esta variable se usa al construir el frontend en Docker
# Debe apuntar a la IP pública de Lightsail con el puerto del backend
VITE_API_BASE_URL=http://3.232.108.231:8081/api

